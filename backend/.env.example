# Copy this file to .env and fill in your key.  .env is gitignored.

# Required for real coaching output (get one at https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — all have sensible defaults if omitted:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/chess_coach
# STOCKFISH_PATH=/opt/homebrew/bin/stockfish
# ANTHROPIC_MODEL=claude-opus-4-8
# FAST_MODEL=claude-haiku-4-5
